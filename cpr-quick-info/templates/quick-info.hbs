<div class="cqi-card">
  <div class="cqi-head">
    <img class="cqi-portrait" src="{{img}}" alt="" />
    <div class="cqi-head-main">
      <div class="cqi-name{{#if nameHidden}} cqi-name-hidden{{/if}}">{{name}}</div>
      {{#if roles.length}}
        <div class="cqi-roles">
          {{#each roles}}
            <span class="cqi-role{{#if active}} cqi-role-active{{/if}}">{{name}}{{#if rank}} · Rank {{rank}}{{/if}}</span>
          {{/each}}
        </div>
      {{/if}}
    </div>
  </div>

  {{#if wound}}
    <div class="cqi-vitals">
      <span class="cqi-wound-tag cqi-wound-{{wound.key}}">{{wound.label}}</span>
      {{#if humanity}}<span class="cqi-humanity">HUM {{humanity.value}}/{{humanity.max}}</span>{{/if}}
    </div>
  {{/if}}

  {{#if armor.length}}
    <div class="cqi-armor-row">
      {{#each armor}}
        <span class="cqi-armor-chip">{{label}} {{value}}/{{max}}</span>
      {{/each}}
    </div>
  {{/if}}

  {{#if criticalInjuries.length}}
    <div class="cqi-section-label">Critical Injuries</div>
    <div class="cqi-gear-list">
      {{#each criticalInjuries}}
        <div class="cqi-gear-row">
          <img class="cqi-gear-icon" src="{{img}}" alt="" />
          <span class="cqi-gear-name">{{name}}</span>
          {{#if location}}<span class="cqi-gear-tag cqi-crit-tag">{{location}}</span>{{/if}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{#if notes}}
    <div class="cqi-notes">{{notes}}</div>
  {{/if}}

  {{#if weapons.length}}
    <div class="cqi-section-label">Weapons</div>
    <div class="cqi-gear-list">
      {{#each weapons}}
        <div class="cqi-gear-row{{#if wielded}} cqi-gear-wielded{{/if}}">
          <img class="cqi-gear-icon" src="{{img}}" alt="" />
          <span class="cqi-gear-name">{{name}}</span>
          {{#if wielded}}<span class="cqi-gear-tag">Readied</span>{{/if}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{#if cyberware.length}}
    <div class="cqi-section-label">Cyberware</div>
    <div class="cqi-gear-list">
      {{#each cyberware}}
        <div class="cqi-gear-row">
          <img class="cqi-gear-icon" src="{{img}}" alt="" />
          <span class="cqi-gear-name">{{name}}</span>
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{#unless weapons.length}}{{#unless cyberware.length}}
    <div class="cqi-empty">No known gear.</div>
  {{/unless}}{{/unless}}
</div>
